{
  "name": "perpus-app",
  "private": true,
  "scripts": {
    "prisma:generate": "cd packages/prisma-client && bun run generate",
    "prisma:migrate": "cd packages/prisma-client && bun run migrate:dev",
    "prisma:studio": "cd packages/prisma-client && bun run studio",
    "prisma:push": "cd packages/prisma-client && bun run push",
    "build": "turbo run build",
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.0"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
