{
  "name": "@perpus-app/prisma-client",
  "version": "1.0.0",
  "main": "./prisma/generated/client/index.js",
  "types": "./prisma/generated/client/index.d.ts",
  "private": true,
  "scripts": {
    "generate": "prisma generate --schema=./prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "studio": "prisma studio --schema=./prisma/schema.prisma",
    "push": "prisma db push --schema=./prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.1.3"
  }
}